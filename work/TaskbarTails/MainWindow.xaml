<Window x:Class="TaskbarTails.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TaskbarTails"
 Title="{local:T app_title}" Width="960" Height="860" MinWidth="820" MinHeight="640"
 Background="#F7F7F2" FontFamily="Malgun Gothic" Foreground="#273E37" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,11"/>
   <Setter Property="Background" Value="#EAF0E9"/><Setter Property="Foreground" Value="#285948"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#7E8A80"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="SettingLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#36765F"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#EDF0E9"/><Setter Property="Foreground" Value="#78A58B"/></Style>
 </Window.Resources>
 <ScrollViewer Background="#F7F7F2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="32,25,32,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="TASKBAR TAILS" FontSize="13" FontWeight="Bold" Foreground="#4E8269"/><TextBlock Text="{local:T brand_sub}" FontSize="29" FontWeight="Bold" Margin="0,9,0,6"/><TextBlock Text="{local:T brand_desc}" Foreground="#7B877E" FontSize="13"/></StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8EEE2" CornerRadius="13" Padding="12,6"><TextBlock x:Name="VersionBadge" Text="●  PIXEL PETS" FontSize="10" FontWeight="Bold" Foreground="#5F7E52"/></Border>
  </Grid>
  <Grid Grid.Row="1" Margin="0,25,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Background="#E8EEDC" CornerRadius="22" Padding="23,19">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="MY LITTLE COMPANION" FontSize="10" FontWeight="Bold" Foreground="#758767"/><TextBlock x:Name="LevelLabel" Text="Lv. 1" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#4D7257"/></Grid>
     <Grid Grid.Row="1"><Ellipse Width="210" Height="150" Fill="#F4F6E9" VerticalAlignment="Bottom" Margin="0,0,0,14"/><local:PetVisual x:Name="Preview" Width="205" Height="220" ShowName="False"/></Grid>
     <StackPanel Grid.Row="2" HorizontalAlignment="Center"><TextBlock x:Name="PetTitle" Text="모찌" FontSize="24" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="MoodLabel" FontSize="12" Foreground="#71816B" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Column="2">
    <TextBlock Text="{local:T care_title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
    <Border Background="White" CornerRadius="17" Padding="20,16"><StackPanel>
     <Grid><TextBlock Text="{local:T fullness}" FontSize="12"/><TextBlock x:Name="FoodLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="FoodBar" Margin="0,9,0,16"/>
     <Grid><TextBlock Text="{local:T happiness}" FontSize="12"/><TextBlock x:Name="HappyLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="HappyBar" Margin="0,9,0,16" Foreground="#E4B574"/>
     <Grid><TextBlock Text="{local:T xp}" FontSize="12"/><TextBlock x:Name="XpLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="XpBar" Margin="0,9,0,0" Foreground="#9B9EC6"/>
    </StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,13,0,0"><Button x:Name="FeedButton" Content="{local:T feed}" Click="Feed_Click" Margin="0,0,6,0" Padding="8,13" Background="#36765F" Foreground="White"/><Button Content="{local:T play}" Click="Play_Click" Margin="0,0,6,0" Padding="8,13"/><Button x:Name="SleepButton" Content="{local:T sleep}" Click="Sleep_Click" Padding="8,13"/></UniformGrid>
    <UniformGrid Columns="2" Margin="0,10,0,0"><Button x:Name="ActionOne" Click="ActionOne_Click" Margin="0,0,6,0" Padding="8,10"/><Button x:Name="ActionTwo" Click="ActionTwo_Click" Padding="8,10"/></UniformGrid>
    <TextBlock Text="{local:T customize}" FontSize="12" FontWeight="Bold" Margin="0,21,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
     <TextBox x:Name="NameBox" MaxLength="12" VerticalContentAlignment="Center" Padding="9,6" Background="White" BorderBrush="#DDE3D8"/>
     <ComboBox x:Name="SpeciesBox" Grid.Column="1" Margin="7,0"/>
     <Button Grid.Column="2" Content="{local:T apply}" Click="Apply_Click" Padding="8,9"/>
    </Grid>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="18" Padding="21,18" Margin="0,20,0,0">
   <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{local:T group_title}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{local:T group_desc}" FontSize="12" Foreground="#7B877E" Margin="0,5,0,0"/><TextBlock Text="{local:T group_desc2}" FontSize="11" Foreground="#929A90" Margin="0,7,0,0"/><TextBlock x:Name="RoomInfo" FontSize="12" FontWeight="Bold" Foreground="#36765F" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{local:T room_button}" Click="Room_Click" Margin="18,0,0,10" Padding="12,9"/><CheckBox x:Name="FriendsCheck" Content="{local:T demo_friends}" Margin="18,0,0,0" Checked="Friends_Changed" Unchecked="Friends_Changed"/></StackPanel>
   </Grid>
   <TextBlock Text="{local:T bubble_title}" FontSize="12" FontWeight="Bold" Margin="0,16,0,7"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="BubbleBox" MaxLength="80" VerticalContentAlignment="Center" Padding="9,7" Background="#F7F7F2" BorderBrush="#DDE3D8" KeyDown="Bubble_KeyDown"/>
    <Button Grid.Column="1" Content="{local:T bubble_send}" Click="Bubble_Click" Margin="8,0,0,0" Padding="12,8" Background="#36765F" Foreground="White"/>
   </Grid>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{local:T quick_hint}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <WrapPanel x:Name="ReactionPanel" Grid.Column="1"/>
   </Grid>
   <TextBlock x:Name="QuickTip" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
   <TextBlock Text="{local:T bubble_note}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Background="White" CornerRadius="18" Padding="21,18" Margin="0,20,0,0">
   <StackPanel>
    <TextBlock Text="{local:T settings_title}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_language}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="Language_Changed"><ComboBoxItem Content="{local:T lang_auto}"/><ComboBoxItem Content="{local:T lang_ko}"/><ComboBoxItem Content="{local:T lang_en}"/></ComboBox></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_monitor}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="MonitorBox" Grid.Column="1" SelectionChanged="Monitor_Changed"/></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_size}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="ScaleBox" Grid.Column="1" SelectionChanged="Scale_Changed"><ComboBoxItem Content="{local:T size_default}"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/></ComboBox></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_idle}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="IdleBox" Grid.Column="1" SelectionChanged="Idle_Changed"/></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_chat_hotkey}" Style="{StaticResource SettingLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="HotkeyCapture" Click="HotkeyCapture_Click" Padding="8,7" FontSize="12" Background="#F1F4EE"/><Button Grid.Column="1" Content="{local:T hotkey_reset}" Click="HotkeyReset_Click" Padding="8,7" FontSize="11" Margin="6,0,0,0"/></Grid></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_hide_hotkey}" Style="{StaticResource SettingLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="HideHotkeyCapture" Click="HideHotkeyCapture_Click" Padding="8,7" FontSize="12" Background="#F1F4EE"/><Button Grid.Column="1" Content="{local:T hotkey_reset}" Click="HideHotkeyReset_Click" Padding="8,7" FontSize="11" Margin="6,0,0,0"/></Grid></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_bubble_hotkey}" Style="{StaticResource SettingLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BubbleHotkeyCapture" Click="BubbleHotkeyCapture_Click" Padding="8,7" FontSize="12" Background="#F1F4EE"/><Button Grid.Column="1" Content="{local:T hotkey_reset}" Click="BubbleHotkeyReset_Click" Padding="8,7" FontSize="11" Margin="6,0,0,0"/></Grid></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_name_style}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="NameStyleBox" Grid.Column="1" SelectionChanged="NameStyle_Changed"><ComboBoxItem Content="{local:T name_hidden}"/><ComboBoxItem Content="{local:T name_small}"/><ComboBoxItem Content="{local:T name_large}"/></ComboBox></Grid>
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{local:T set_bubble_style}" Style="{StaticResource SettingLabel}"/><ComboBox x:Name="BubbleStyleBox" Grid.Column="1" SelectionChanged="BubbleStyle_Changed"/></Grid>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <CheckBox x:Name="StartupCheck" Content="{local:T set_startup}" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
      <CheckBox x:Name="HotkeyCheck" Content="{local:T set_hotkeys}" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
      <CheckBox x:Name="NightCheck" Content="{local:T set_night}" Checked="Night_Changed" Unchecked="Night_Changed"/>
      <CheckBox x:Name="StretchCheck" Content="{local:T set_stretch}" Checked="Stretch_Changed" Unchecked="Stretch_Changed"/>
      <CheckBox x:Name="GreetCheck" Content="{local:T set_greet}" Checked="Greet_Changed" Unchecked="Greet_Changed"/>
      <CheckBox x:Name="RejoinCheck" Content="{local:T set_rejoin}" Checked="Rejoin_Changed" Unchecked="Rejoin_Changed"/>
      <CheckBox x:Name="SoundCheck" Content="{local:T set_sound}" Checked="Sound_Changed" Unchecked="Sound_Changed"/>
      <CheckBox x:Name="WindowCheck" Content="{local:T set_window_play}" Checked="WindowPlay_Changed" Unchecked="WindowPlay_Changed"/>
      <CheckBox x:Name="BubblesCheck" Content="{local:T set_bubbles}" Checked="Bubbles_Changed" Unchecked="Bubbles_Changed"/>
      <CheckBox x:Name="EdgeCheck" Content="{local:T set_edge_roam}" Checked="EdgeRoam_Changed" Unchecked="EdgeRoam_Changed"/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="HotkeyNote" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" Foreground="#B5713A" Visibility="Collapsed"/>
    <TextBlock Text="{local:T set_note}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="4" Background="White" CornerRadius="18" Padding="21,18" Margin="0,20,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{local:T about_title}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{local:T about_open_desc}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="1" Content="{local:T about_open}" Click="Info_Click" Margin="18,0,0,0" Padding="12,9" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="5" Margin="0,17,0,0">
   <Grid><TextBlock x:Name="Notice" Text="{local:T footer_hint}" FontSize="11" Foreground="#7B877E" VerticalAlignment="Center" Margin="0,0,300,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="UpdateButton" Content="{local:T update_now}" Click="Update_Click" Padding="12,8" FontSize="11" Margin="0,0,7,0" Background="#E4B574" Foreground="#3F3223" Visibility="Collapsed"/><Button Content="{local:T update_check}" Click="CheckUpdate_Click" Padding="12,8" FontSize="11" Margin="0,0,7,0"/><Button x:Name="VisibilityButton" Content="{local:T hide_pets}" Click="Visibility_Click" Padding="12,8" FontSize="11" Margin="0,0,7,0"/><Button Content="{local:T quit}" Click="Quit_Click" Padding="12,8" FontSize="11" Background="#EEECE6" Foreground="#7F766C"/></StackPanel></Grid>
   <TextBlock Text="{local:T footer_note}" FontSize="10" Foreground="#969D94" Margin="0,9,0,0"/>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</Window>
