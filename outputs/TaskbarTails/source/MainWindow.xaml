<Window x:Class="TaskbarTails.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TaskbarTails"
 Title="Taskbar Tails · 작은 친구들의 하루" Width="940" Height="730" MinWidth="800" MinHeight="630"
 Background="#F7F7F2" FontFamily="Malgun Gothic" Foreground="#273E37" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,11"/>
   <Setter Property="Background" Value="#EAF0E9"/><Setter Property="Foreground" Value="#285948"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#7E8A80"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#EDF0E9"/><Setter Property="Foreground" Value="#78A58B"/></Style>
 </Window.Resources>
 <ScrollViewer Background="#F7F7F2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="32,25,32,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="TASKBAR TAILS" FontSize="13" FontWeight="Bold" Foreground="#4E8269"/><TextBlock Text="작업표시줄 위, 작은 친구들." FontSize="29" FontWeight="Bold" Margin="0,9,0,6"/><TextBlock Text="바쁜 하루에도 함께하는 나만의 작은 반려동물" Foreground="#7B877E" FontSize="13"/></StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8EEE2" CornerRadius="13" Padding="12,6"><TextBlock Text="●  LOCAL PROTOTYPE" FontSize="10" FontWeight="Bold" Foreground="#5F7E52"/></Border>
  </Grid>
  <Grid Grid.Row="1" Margin="0,25,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Background="#E8EEDC" CornerRadius="22" Padding="23,19">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="MY LITTLE COMPANION" FontSize="10" FontWeight="Bold" Foreground="#758767"/><TextBlock x:Name="LevelLabel" Text="Lv. 1" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#4D7257"/></Grid>
     <Grid Grid.Row="1"><Ellipse Width="210" Height="150" Fill="#F4F6E9" VerticalAlignment="Bottom" Margin="0,0,0,14"/><local:PetVisual x:Name="Preview" Width="205" Height="220" ShowName="False"/></Grid>
     <StackPanel Grid.Row="2" HorizontalAlignment="Center"><TextBlock x:Name="PetTitle" Text="모찌" FontSize="24" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="MoodLabel" Text="오늘도 함께 놀 준비 완료!" FontSize="12" Foreground="#71816B" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Column="2">
    <TextBlock Text="오늘의 돌봄" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
    <Border Background="White" CornerRadius="17" Padding="20,16"><StackPanel>
     <Grid><TextBlock Text="포만감" FontSize="12"/><TextBlock x:Name="FoodLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="FoodBar" Margin="0,9,0,16"/>
     <Grid><TextBlock Text="행복도" FontSize="12"/><TextBlock x:Name="HappyLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="HappyBar" Margin="0,9,0,16" Foreground="#E4B574"/>
     <Grid><TextBlock Text="성장 경험치" FontSize="12"/><TextBlock x:Name="XpLabel" HorizontalAlignment="Right" FontSize="12"/></Grid><ProgressBar x:Name="XpBar" Margin="0,9,0,0" Foreground="#9B9EC6"/>
    </StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,13,0,0"><Button Content="먹이 주기" Click="Feed_Click" Margin="0,0,6,0" Padding="8,13" Background="#36765F" Foreground="White"/><Button Content="놀아주기" Click="Play_Click" Margin="0,0,6,0" Padding="8,13"/><Button x:Name="SleepButton" Content="재우기" Click="Sleep_Click" Padding="8,13"/></UniformGrid>
    <TextBlock Text="나의 친구 꾸미기" FontSize="12" FontWeight="Bold" Margin="0,21,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
     <TextBox x:Name="NameBox" MaxLength="12" VerticalContentAlignment="Center" Padding="9,6" Background="White" BorderBrush="#DDE3D8" AutomationProperties.Name="반려동물 이름"/>
     <ComboBox x:Name="SpeciesBox" Grid.Column="1" Margin="7,0" VerticalContentAlignment="Center" SelectedIndex="0" AutomationProperties.Name="반려동물 종류"><ComboBoxItem Content="고양이"/><ComboBoxItem Content="토끼"/></ComboBox>
     <Button Grid.Column="2" Content="적용" Click="Apply_Click" Padding="8,9"/>
    </Grid>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="18" Padding="21,18" Margin="0,20,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="작은 친구들의 모임" FontSize="15" FontWeight="Bold"/><TextBlock Text="복숭아와 구름이를 작업표시줄에 불러보세요." FontSize="12" Foreground="#7B877E" Margin="0,5,0,0"/><TextBlock Text="로컬 데모 · 실제 방 만들기와 온라인 초대는 다음 버전에 연결됩니다." FontSize="11" Foreground="#929A90" Margin="0,7,0,0"/></StackPanel>
    <CheckBox x:Name="FriendsCheck" Grid.Column="1" Content="데모 친구 2마리" VerticalAlignment="Center" Margin="18,0,0,0" Checked="Friends_Changed" Unchecked="Friends_Changed" Foreground="#36765F"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,17,0,0">
   <Grid><TextBlock x:Name="Notice" Text="캐릭터 클릭: 쓰다듬기  ·  드래그: 자리 이동  ·  우클릭: 메뉴" FontSize="11" Foreground="#7B877E" VerticalAlignment="Center" Margin="0,0,230,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="VisibilityButton" Content="캐릭터 숨기기" Click="Visibility_Click" Padding="12,8" FontSize="11" Margin="0,0,7,0"/><Button Content="종료" Click="Quit_Click" Padding="12,8" FontSize="11" Background="#EEECE6" Foreground="#7F766C"/></StackPanel></Grid>
   <TextBlock Text="창을 닫아도 친구는 남아 있어요. 트레이 아이콘 또는 캐릭터를 더블클릭하면 다시 열립니다." FontSize="10" Foreground="#969D94" Margin="0,9,0,0"/>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</Window>

